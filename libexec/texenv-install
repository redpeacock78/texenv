#!/usr/bin/env bash

declare -r TEXENV_DEBUG
[[ "${TEXENV_DEBUG}" == 1 ]] && set -x
set -euo pipefail

# State used by the EXIT trap after cmdInstall returns.
declare TEX_DIR
declare TEX_TMP_DIR
declare TEX_STAGE_DIR
declare TEX_BACKUP_DIR
declare VERSION
declare INSTALL_STATUS
declare CMD_NAME
declare TEX_INSTALL_MOVED

# Install specified TeX Live version
cmdInstall() {
  declare TEX_URL
  declare TEX_URL_PERFIX
  declare TEX_TMP
  declare TINYTEX_ARCHIVE_NAME
  declare ARCHIVE_DIGEST
  declare ARCHIVE_HASH
  declare VERSION_LIST
  declare FORCE_INSTALL
  declare SCRIPT_NAME
  declare SUBCMD_NAME
  declare libs
  declare -a runHooks
  declare cmdHelp
  SCRIPT_NAME="${0##*/}"
  CMD_NAME="${SCRIPT_NAME%%-*}"
  SUBCMD_NAME="${SCRIPT_NAME##*-}"
  TEX_URL_PERFIX="https://github.com/rstudio/tinytex-releases/releases/download"
  libs="$(builtin type -P "${CMD_NAME}-libs" || true)"
  cmdHelp="$(builtin type -P "${CMD_NAME}-help" || true)"
  runHooks=("${libs}" runHooks)
  [[ -z "${libs}" || -z "${cmdHelp}" ]] && {
    builtin echo "${CMD_NAME}: required component(s) missing" >&2
    exit 1
  }
  versionList() {
    declare PER_PAGE
    if [[ "${1:-}" == "-a" || "${1:-}" == "--all" ]]; then
      PER_PAGE="?per_page=100"
    fi
    curl -sL "https://api.github.com/repos/rstudio/tinytex-releases/releases${PER_PAGE:-}" |
      awk '/"tag_name"/{value=$2;gsub(/[",]/,"",value);sub(/^v/,"",value);print value}' |
      awk '{a[NR]=$0}END{for(i=NR;i>0;i--){print a[i]}}'
  }
  archiveDigest() {
    declare RELEASE_TAG
    declare RELEASE_JSON
    if [[ "${VERSION}" == "daily" ]]; then
      RELEASE_TAG="daily"
    else
      RELEASE_TAG="v${VERSION}"
    fi
    if ! RELEASE_JSON="$(curl -fsSL "https://api.github.com/repos/rstudio/tinytex-releases/releases/tags/${RELEASE_TAG}")"; then
      return 1
    fi
    if [[ -n "$(builtin type -P jq || true)" ]]; then
      builtin printf '%s' "${RELEASE_JSON}" |
        jq -r --arg asset "${TINYTEX_ARCHIVE_NAME}" '.assets[] | select(.name == $asset) | .digest // empty'
    else
      builtin printf '%s' "${RELEASE_JSON}" |
        tr -d '\r\n' |
        awk -v asset="${TINYTEX_ARCHIVE_NAME}" '
          BEGIN {RS="\\}[[:space:]]*,[[:space:]]*\\{"}
          index($0, "\"name\"") && index($0, "\"" asset "\"") {
            value=$0
            sub(/^.*"digest"[[:space:]]*:[[:space:]]*"sha256:/, "", value)
            sub(/".*/, "", value)
            if (value ~ /^[[:xdigit:]]{64}$/) {
              print "sha256:" value
              exit
            }
          }'
    fi
  }
  sha256File() {
    declare FILE
    declare HASH_TOOL
    declare OUTPUT
    declare HASH
    FILE="${1:?}"
    HASH_TOOL="$(builtin type -P sha256sum || true)"
    if [[ -n "${HASH_TOOL}" ]]; then
      OUTPUT="$("${HASH_TOOL}" "${FILE}")" || return 1
      read -r HASH _ <<< "${OUTPUT}"
    else
      HASH_TOOL="$(builtin type -P shasum || true)"
      if [[ -n "${HASH_TOOL}" ]]; then
        OUTPUT="$("${HASH_TOOL}" -a 256 "${FILE}")" || return 1
        read -r HASH _ <<< "${OUTPUT}"
      else
        HASH_TOOL="$(builtin type -P openssl || true)"
        [[ -n "${HASH_TOOL}" ]] || return 1
        OUTPUT="$("${HASH_TOOL}" dgst -sha256 "${FILE}")" || return 1
        HASH="${OUTPUT##*= }"
      fi
    fi
    [[ "${HASH}" =~ ^[[:xdigit:]]{64}$ ]] || return 1
    builtin printf '%s\n' "${HASH,,}"
  }
  case "${1:-}" in
    -l | --list)
      case "${2:-}" in
        -a | --all)
          versionList "${2}"
          exit 0
          ;;
        -h | --help)
          builtin exec "${cmdHelp}" "${SUBCMD_NAME}" "${@}"
          ;;
      esac
      versionList
      exit 0
      ;;
    -f | --force)
      FORCE_INSTALL=1
      shift || true
      VERSION="${1:-}"
      ;;
    -h | --help)
      builtin exec "${cmdHelp}" "${SUBCMD_NAME}"
      ;;
    *)
      VERSION="${1:-}"
      ;;
  esac
  [[ -d "${TEXENV_ROOT}" && -d "${TEXENV_VERSIONS}" && -d "${TEXENV_CONFIG}" && -d "${TEXENV_SHIMS}" ]] || {
    builtin echo "${CMD_NAME}: run '${CMD_NAME} init' first" >&2
    exit 1
  }
  [[ -z "${VERSION}" ]] && {
    builtin echo "${CMD_NAME}: ${SUBCMD_NAME} [options] <version>" >&2
    exit 1
  }
  "${libs}" isSafeVersion "${VERSION}" || {
    builtin echo "${CMD_NAME}: invalid version identifier" >&2
    exit 1
  }
  TEX_DIR="${TEXENV_VERSIONS}/${VERSION/daily/daily-$(date +%Y.%m.%d)}"
  [[ -d "${TEX_DIR}" && "${FORCE_INSTALL:-0}" != 1 ]] && {
    builtin echo "${CMD_NAME}: version ${VERSION} is already installed" >&2
    exit 1
  }
  VERSION_LIST="$(versionList)"
  grep -qxF "${VERSION}" <<< "${VERSION_LIST}" || {
    builtin echo "${CMD_NAME}: version '${VERSION}' is not available" >&2
    exit 1
  }
  if [[ "${VERSION}" == "daily" ]]; then
    TINYTEX_ARCHIVE_NAME="TinyTeX-1.${TINYTEX_ARCHIVE_EXT}"
    TEX_URL="${TEX_URL_PERFIX}/daily/${TINYTEX_ARCHIVE_NAME}"
    URL_STATUS="$(curl -sSIL "${TEX_URL}" -o /dev/null -w "%{http_code}")"
    [[ "${URL_STATUS}" != "200" ]] && {
      TINYTEX_ARCHIVE_EXT="tar.xz"
      if [[ "${OS_NAME}" == "Darwin" ]]; then
        TINYTEX_ARCHIVE_NAME="TinyTeX-1-${OS_NAME,,}.${TINYTEX_ARCHIVE_EXT}"
      else
        TINYTEX_ARCHIVE_NAME="TinyTeX-1-${OS_NAME,,}-${ARCH,,}.${TINYTEX_ARCHIVE_EXT}"
      fi
      TEX_URL="${TEX_URL_PERFIX}/daily/${TINYTEX_ARCHIVE_NAME}"
    }
  else
    TINYTEX_ARCHIVE_NAME="TinyTeX-1-v${VERSION}.${TINYTEX_ARCHIVE_EXT}"
    TEX_URL="${TEX_URL_PERFIX}/v${VERSION}/${TINYTEX_ARCHIVE_NAME}"
    URL_STATUS="$(curl -sSIL "${TEX_URL}" -o /dev/null -w "%{http_code}")"
    [[ "${URL_STATUS}" != "200" ]] && {
      TINYTEX_ARCHIVE_EXT="tar.xz"
      if [[ "${OS_NAME}" == "Darwin" ]]; then
        TINYTEX_ARCHIVE_NAME="TinyTeX-1-${OS_NAME,,}-v${VERSION}.${TINYTEX_ARCHIVE_EXT}"
      else
        TINYTEX_ARCHIVE_NAME="TinyTeX-1-${OS_NAME,,}-${ARCH,,}-v${VERSION}.${TINYTEX_ARCHIVE_EXT}"
      fi
      TEX_URL="${TEX_URL_PERFIX}/v${VERSION}/${TINYTEX_ARCHIVE_NAME}"
    }
  fi
  if ! ARCHIVE_DIGEST="$(archiveDigest)"; then
    builtin echo "${CMD_NAME}: failed to retrieve archive checksum for ${TINYTEX_ARCHIVE_NAME}" >&2
    exit 1
  fi
  [[ "${ARCHIVE_DIGEST}" == sha256:* ]] || {
    builtin echo "${CMD_NAME}: no SHA-256 digest published for ${TINYTEX_ARCHIVE_NAME}" >&2
    exit 1
  }
  ARCHIVE_DIGEST="${ARCHIVE_DIGEST#sha256:}"
  [[ "${ARCHIVE_DIGEST}" =~ ^[[:xdigit:]]{64}$ ]] || {
    builtin echo "${CMD_NAME}: invalid SHA-256 digest published for ${TINYTEX_ARCHIVE_NAME}" >&2
    exit 1
  }
  ARCHIVE_DIGEST="${ARCHIVE_DIGEST,,}"
  TEX_TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/texenv-install.XXXXXX")"
  TEX_TMP="${TEX_TMP_DIR}/${TINYTEX_ARCHIVE_NAME}"
  TEX_STAGE_DIR="$(mktemp -d "${TEXENV_VERSIONS}/.texenv-install.XXXXXX")"
  cleanup() {
    declare STATUS
    STATUS=$?
    [[ -n "${TEX_TMP_DIR:-}" && -d "${TEX_TMP_DIR}" ]] && rm -rf "${TEX_TMP_DIR:?}" || true
    [[ "${INSTALL_STATUS:-0}" != 1 ]] && {
      [[ -n "${TEX_STAGE_DIR:-}" && -d "${TEX_STAGE_DIR}" ]] && rm -rf "${TEX_STAGE_DIR:?}" || true
      if [[ "${TEX_INSTALL_MOVED:-0}" == 1 ]]; then
        [[ -d "${TEX_DIR}" ]] && rm -rf "${TEX_DIR:?}" || true
      fi
      if [[ -n "${TEX_BACKUP_DIR:-}" && -d "${TEX_BACKUP_DIR}" ]]; then
        mv "${TEX_BACKUP_DIR}" "${TEX_DIR}" || true
      fi
      builtin echo "${CMD_NAME}: failed to install version ${VERSION}" >&2
    }
    [[ "${INSTALL_STATUS:-0}" == 1 && -n "${TEX_BACKUP_DIR:-}" && -d "${TEX_BACKUP_DIR}" ]] && rm -rf "${TEX_BACKUP_DIR:?}" || true
    return "${STATUS}"
  }
  trap cleanup EXIT INT TERM
  builtin echo "Installing TeX Live version ${VERSION}..."
  [[ "${FORCE_INSTALL:-0}" == 1 ]] && {
    builtin echo "Reinstalling existing version ${VERSION}..."
  }
  builtin echo "Downloading TinyTeX: ${TINYTEX_ARCHIVE_NAME}"
  curl -L -f --retry 10 --retry-delay 30 -# "${TEX_URL}" -o "${TEX_TMP}"
  if ! ARCHIVE_HASH="$(sha256File "${TEX_TMP}")"; then
    builtin echo "${CMD_NAME}: unable to calculate archive checksum" >&2
    exit 1
  fi
  [[ "${ARCHIVE_HASH}" == "${ARCHIVE_DIGEST}" ]] || {
    builtin echo "${CMD_NAME}: archive checksum mismatch for ${TINYTEX_ARCHIVE_NAME}" >&2
    exit 1
  }
  tar xf "${TEX_TMP}" -C "${TEX_STAGE_DIR}" --strip-components=1
  [[ -d "${TEX_STAGE_DIR}/bin/${TEXENV_PLATFORM}" ]] || {
    builtin echo "${CMD_NAME}: downloaded archive has no ${TEXENV_PLATFORM} binaries" >&2
    exit 1
  }
  if [[ -d "${TEX_DIR}" ]]; then
    TEX_BACKUP_DIR="${TEXENV_VERSIONS}/.texenv-backup.${$}"
    mv "${TEX_DIR}" "${TEX_BACKUP_DIR}"
  fi
  mv "${TEX_STAGE_DIR}" "${TEX_DIR}"
  TEX_INSTALL_MOVED=1
  builtin echo "TeX Live version ${VERSION} installed successfully."
  "${runHooks[@]}" "${SUBCMD_NAME}" post "${@}"
  INSTALL_STATUS=1
  [[ -n "${TEX_TMP_DIR:-}" && -d "${TEX_TMP_DIR}" ]] && rm -rf "${TEX_TMP_DIR:?}" || true
  [[ -n "${TEX_BACKUP_DIR:-}" && -d "${TEX_BACKUP_DIR}" ]] && rm -rf "${TEX_BACKUP_DIR:?}" || true
  trap - EXIT INT TERM
}

cmdInstall "${@}"
