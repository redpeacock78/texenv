#!/usr/bin/env bash

declare -r TEXENV_DEBUG
[[ "${TEXENV_DEBUG}" == 1 ]] && set -x
set -euo pipefail

# State used by the EXIT trap after cmdFreeze returns.
declare TMP_FILE

# Freeze TeX packages to requirements file
cmdFreeze() {
  declare FILE
  declare TEX_VERSION
  declare SCRIPT_NAME
  declare cmdHelp
  declare cmdExec
  declare cmdVersion
  SCRIPT_NAME="${0##*/}"
  cmdHelp="$(builtin type -P "texenv-help" || true)"
  cmdExec="$(builtin type -P "texenv-exec" || true)"
  cmdVersion="$(builtin type -P "texenv-version" || true)"
  [[ -z "${cmdHelp}" || -z "${cmdExec}" || -z "${cmdVersion}" ]] && {
    builtin echo "${SCRIPT_NAME%%-*}: required component(s) missing" >&2
    exit 1
  }
  "${cmdVersion}" > /dev/null
  FILE="${TEX_REQUIREMENTS_FILE}"
  case "${1:-}" in
    -l | --lock)
      FILE="${TEX_REQUIREMENTS_LOCK_FILE}"
      TEX_VERSION="$("${cmdExec}" tlmgr --version | awk 'END{print $5}')"
      ;;
    -h | --help)
      builtin exec "${cmdHelp}" "${SCRIPT_NAME##*-}"
      ;;
  esac
  TMP_FILE="$(mktemp "${FILE}.XXXXXX")"
  cleanup() {
    [[ -n "${TMP_FILE:-}" && -f "${TMP_FILE}" ]] && rm -f "${TMP_FILE:?}" || true
  }
  trap cleanup EXIT INT TERM
  builtin echo "Freezing TeX packages to ${FILE}..."
  {
    [[ -z "${TEX_VERSION:-}" ]] || builtin printf '# TeX Live: %s\n' "${TEX_VERSION}"
    "${cmdExec}" tlmgr info --only-installed --data name
  } > "${TMP_FILE}" || {
    builtin echo "${SCRIPT_NAME%%-*}: failed to freeze TeX packages" >&2
    exit 1
  }
  mv "${TMP_FILE}" "${FILE}" || {
    builtin echo "${SCRIPT_NAME%%-*}: failed to freeze TeX packages" >&2
    exit 1
  }
  trap - EXIT INT TERM
}

cmdFreeze "${@}"
