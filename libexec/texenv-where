#!/usr/bin/env bash

declare -r TEXENV_DEBUG
[[ "${TEXENV_DEBUG}" == 1 ]] && set -x
set -euo pipefail

# Show path to command for specified command
cmdWhere() {
  declare CMD_NAME
  declare CMD_PATH
  declare VERSION
  declare -A TEX_VERSION_INFO
  declare SCRIPT_NAME
  declare libs
  declare cmdHelp
  SCRIPT_NAME="${0##*/}"
  libs="$(builtin type -P "texenv-libs" || true)"
  cmdHelp="$(builtin type -P "texenv-help" || true)"
  [[ -z "${libs}" || -z "${cmdHelp}" ]] && {
    builtin echo "${SCRIPT_NAME%%-*}: required component(s) missing" >&2
    exit 1
  }
  case "${1:-}" in
    -h | --help)
      builtin exec "${cmdHelp}" "${SCRIPT_NAME##*-}"
      ;;
  esac
  CMD_NAME="${1:-}"
  [[ -z "${CMD_NAME}" ]] && {
    builtin echo "${SCRIPT_NAME%%-*}: no command specified" >&2
    exit 1
  }
  while IFS=': ' read -r KEY VALUE; do
    [[ -n "${KEY}" && -n "${VALUE}" ]] && TEX_VERSION_INFO["${KEY}"]="${VALUE}"
  done < <("${libs}" resolveVersion || true)
  VERSION="${TEX_VERSION_INFO["TinyTeX-Version"]:-}"
  [[ -z "${VERSION}" ]] && {
    builtin echo "${SCRIPT_NAME%%-*}: no version set (use '${SCRIPT_NAME%%-*} global <version>' or '${SCRIPT_NAME%%-*} local <version>')" >&2
    exit 1
  }
  CMD_PATH="${TEXENV_VERSIONS}/${VERSION}/bin/${TEXENV_PLATFORM}/${CMD_NAME}"
  [[ -x "${CMD_PATH}" ]] || {
    builtin echo "${SCRIPT_NAME%%-*}: command '${CMD_NAME}' not found in version '${VERSION}'" >&2
    exit 1
  }
  builtin echo "${CMD_PATH}"
}

cmdWhere "${@}"
