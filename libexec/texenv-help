  declare SUBCMD_NAME
  declare SUBCMD_USAGE
  SCRIPT_NAME="${0##*/}"
  SUBCMD_NAME="${FUNCNAME[0]##help}"
  SUBCMD_USAGE="${SUBCMD_NAME,,} <cmd>"
