#!/usr/bin/env bash

declare -r TEXENV_DEBUG
[[ "${TEXENV_DEBUG}" == 1 ]] && set -x
set -euo pipefail

helpCommands() {
  declare SCRIPT_NAME
  declare SUBCMD_NAME
  declare SUBCMD_USAGE
  SCRIPT_NAME="${0##*/}"
  SUBCMD_NAME="${FUNCNAME[0]##help}"
  SUBCMD_USAGE="${SUBCMD_NAME,,} [options]"
  [[ "${1:-}" != "desc" ]] && builtin echo "Usage: ${SCRIPT_NAME%%-*} ${SUBCMD_USAGE}"
  builtin echo "$([[ "${1:-}" == "desc" ]] && builtin echo "${SUBCMD_USAGE}            ")List available commands"
  [[ "${1:-}" != "desc" ]] && builtin echo "Options:"
  [[ "${1:-}" != "desc" ]] && builtin echo "  -h, --help  Show this help message"
}

helpEnv() {
  declare SCRIPT_NAME
  declare SUBCMD_NAME
  declare SUBCMD_USAGE
  SCRIPT_NAME="${0##*/}"
  SUBCMD_NAME="${FUNCNAME[0]##help}"
  SUBCMD_USAGE="${SUBCMD_NAME,,} [options]"
