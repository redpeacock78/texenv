  builtin echo "$([[ "${1:-}" == "desc" ]] && builtin echo "${SUBCMD_USAGE}                   ")Show path to shim for specified command"
  [[ "${1:-}" != "desc" ]] && builtin echo "Options:"
  [[ "${1:-}" != "desc" ]] && builtin echo "  -h, --help  Show this help message"
}

cmdHelp() {
  declare SCRIPT_NAME
  SCRIPT_NAME="${0##*/}"
  builtin echo "USAGE: ${SCRIPT_NAME%%-*} <command> [<args>]"
  builtin echo "Commands:"
  while read -r FUNC_NAME; do
    if [[ "${FUNC_NAME}" == "helpShell" ]]; then
      builtin echo "  $(builtin eval "$("${FUNC_NAME}" desc)")"
    else
      builtin echo "  $("${FUNC_NAME}" desc)"
    fi
  done <<< "${@}"
  builtin echo "  help                          Show this help message"
}

main() {
  declare HELP_FUNCS
  declare SUBCMD_NAMES
  declare PATTERNS
  HELP_FUNCS="$(declare -F | awk '/ help[A-Z][a-z]*$/{print $3}')"
  IFS=" " read -r -a SUBCMD_NAMES <<< "$(awk -v 'ORS= ' '{sub("help","");print tolower($0)}' <<< "${HELP_FUNCS}")"
  PATTERNS="$(
    IFS="|"
    builtin echo "${SUBCMD_NAMES[*]}"
  )"
  if [[ "${1:-}" != @(${PATTERNS}) ]]; then
    cmdHelp "${HELP_FUNCS}"
  else
    if [[ "${1:-}" == "install" ]]; then
      "help${1^}" "${@:2}"
    elif [[ "${1:-}" == "shell" ]]; then
      builtin eval "$("help${1^}")"
    else
      "help${1^}"
    fi
  fi
}

main "${@}"
