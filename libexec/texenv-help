#!/usr/bin/env bash

declare -r TEXENV_DEBUG
[[ "${TEXENV_DEBUG}" == 1 ]] && set -x
set -euo pipefail

declare -ar HELP_COMMANDS=(
  commands doctor env exec freeze global init install local rehash repo restore root shell
  shims uninstall version versions whence where which
)
declare -A HELP_USAGE HELP_DESC HELP_OPTIONS HELP_EXTRA
HELP_USAGE[commands]='commands [options]'
HELP_USAGE[doctor]='doctor [options]'
HELP_USAGE[env]='env [options]'
HELP_USAGE[exec]='exec <cmd> [args]'
HELP_USAGE[freeze]='freeze [options]'
HELP_USAGE[global]='global [options] <version>'
HELP_USAGE[init]='init [options]'
HELP_USAGE[install]='install [options] <version>'
HELP_USAGE[local]='local [options] <version>'
HELP_USAGE[rehash]='rehash [options]'
HELP_USAGE[repo]='repo [options] [<repo>]'
HELP_USAGE[restore]='restore [options]'
HELP_USAGE[root]='root [options]'
HELP_USAGE[shell]='shell [options] <version>'
HELP_USAGE[shims]='shims [options]'
HELP_USAGE[uninstall]='uninstall [options] <version>'
HELP_USAGE[version]='version [options]'
HELP_USAGE[versions]='versions [options]'
HELP_USAGE[whence]='whence <cmd>'
HELP_USAGE[where]='where <cmd>'
HELP_USAGE[which]='which <cmd>'

HELP_DESC[commands]='List available commands'
HELP_DESC[doctor]='Diagnose the TeX environment'
HELP_DESC[env]='Display @program@ environment information'
HELP_DESC[exec]='Execute command in current TeX Live version'
HELP_DESC[freeze]='Freeze installed TeX packages to requirements file'
HELP_DESC[global]='Set global TeX Live version'
HELP_DESC[init]='Initialize @program@ environment'
HELP_DESC[install]='Install specified TeX Live version'
HELP_DESC[local]='Set local TeX Live version'
HELP_DESC[rehash]='Rebuild shims for installed TeX Live versions'
HELP_DESC[repo]='Manage tlmgr repository'
HELP_DESC[restore]='Restore TeX packages from requirements file'
HELP_DESC[root]='Show @program@ root directory'
HELP_DESC[shell]='Spawn a new shell with specified TeX Live version'
HELP_DESC[shims]='Show executable file(s) from @program@ shims directory'
HELP_DESC[uninstall]='Uninstall specified TeX Live version'
HELP_DESC[version]='Show current TeX Live version'
HELP_DESC[versions]='List installed TeX Live versions'
HELP_DESC[whence]='Show path to command in all installed TeX Live versions'
HELP_DESC[where]='Show path to command in current TeX Live version'
HELP_DESC[which]='Show path to shim for specified command'

HELP_OPTIONS[commands]='  -h, --help  Show this help message'
HELP_OPTIONS[doctor]='  -h, --help  Show this help message'
HELP_OPTIONS[env]='  -h, --help  Show this help message'
HELP_OPTIONS[exec]='  -h, --help  Show this help message'
HELP_OPTIONS[freeze]=$'  -l, --lock     Freeze to lock file with TeX Live version\n  -a, --archive  Include package backup archives\n  -h, --help     Show this help message'
HELP_OPTIONS[global]='  -h, --help  Show this help message'
HELP_OPTIONS[init]=$'  -           Output shell commands to set up @program@ environment\n  -h, --help  Show this help message'
HELP_OPTIONS[install]=$'  -l, --list  List available versions\n  -f, --force Force reinstall if version is already installed\n  -h, --help  Show this help message'
HELP_OPTIONS[local]='  -h, --help  Show this help message'
HELP_OPTIONS[rehash]=$'  -f, --force  Force rebuild\n  -h, --help   Show this help message'
HELP_OPTIONS[repo]=$'  -s, --show           Show current tlmgr repository\n  -m, --mirror <repo>  Set tlmgr repository to specified mirror\n  -r, --reset          Reset tlmgr repository to default\n  -h, --help           Show this help message'
HELP_OPTIONS[restore]=$'  -n, --dry-run  Show what would be installed\n  -h, --help     Show this help message'
HELP_OPTIONS[root]='  -h, --help  Show this help message'
HELP_OPTIONS[shell]='  -h, --help  Show this help message'
HELP_OPTIONS[shims]='  -h, --help  Show this help message'
HELP_OPTIONS[uninstall]='  -h, --help  Show this help message'
HELP_OPTIONS[version]='  -h, --help  Show this help message'
HELP_OPTIONS[versions]='  -h, --help  Show this help message'
HELP_OPTIONS[whence]='  -h, --help  Show this help message'
HELP_OPTIONS[where]='  -h, --help  Show this help message'
HELP_OPTIONS[which]='  -h, --help  Show this help message'
HELP_EXTRA[shell]='If no version is specified, the currently configured shell-specific version is used'

helpPrint() {
  declare CMD
  declare MODE
  declare ARG
  declare PROGRAM
  declare USAGE
  declare DESC
  declare EXTRA
  declare OPTIONS
  declare LINE
  CMD="${1}"
  MODE="${2:-normal}"
  ARG="${3:-}"
  PROGRAM="${0##*/}"
  PROGRAM="${PROGRAM%%-*}"
  USAGE="${HELP_USAGE[${CMD}]}"
  DESC="${HELP_DESC[${CMD}]//@program@/${PROGRAM}}"
  EXTRA="${HELP_EXTRA[${CMD}]-}"
  OPTIONS="${HELP_OPTIONS[${CMD}]-}"
  OPTIONS="${OPTIONS//@program@/${PROGRAM}}"
  if [[ "${CMD}" == install && ( "${ARG}" == -l || "${ARG}" == --list ) ]]; then
    USAGE='install [-l|--list] [options]'
    DESC='List available TeX Live versions'
    OPTIONS=$'  -a, --all   List all available versions\n  -h, --help  Show this help message'
    EXTRA=''
  fi
  if [[ "${MODE}" == shell ]]; then
    builtin printf 'builtin echo %q\n' "Usage: ${PROGRAM} ${USAGE}"
    builtin printf 'builtin echo %q\n' "${DESC}"
    [[ -n "${EXTRA}" ]] && builtin printf 'builtin echo %q\n' "${EXTRA}"
    while IFS= read -r LINE; do
      [[ -n "${LINE}" ]] && builtin printf 'builtin echo %q\n' "${LINE}"
    done <<< "${OPTIONS}"
  else
    builtin printf 'Usage: %s %s\n' "${PROGRAM}" "${USAGE}"
    builtin printf '%s\n' "${DESC}"
    [[ -n "${OPTIONS}" ]] && builtin printf 'Options:\n%s\n' "${OPTIONS}"
    [[ -n "${EXTRA}" ]] && builtin printf '%s\n' "${EXTRA}"
  fi
  return 0
}

cmdHelp() {
  declare PROGRAM
  declare CMD
  PROGRAM="${0##*/}"
  PROGRAM="${PROGRAM%%-*}"
  builtin printf 'USAGE: %s <command> [<args>]\n' "${PROGRAM}"
  builtin printf 'Commands:\n'
  for CMD in "${HELP_COMMANDS[@]}"; do
    builtin printf '  %-32s%s\n' "${HELP_USAGE[${CMD}]}" "${HELP_DESC[${CMD}]//@program@/${PROGRAM}}"
  done
  builtin printf '  %-32s%s\n' 'help' 'Show this help message'
}

main() {
  declare CMD
  CMD="${1:-}"
  case "${CMD}" in
    commands | doctor | env | exec | freeze | global | init | install | local | rehash | repo | restore | root | shell | shims | uninstall | version | versions | whence | where | which)
      if [[ "${CMD}" == shell ]]; then
        helpPrint "${CMD}" shell "${@:2}"
      else
        helpPrint "${CMD}" normal "${@:2}"
      fi
      ;;
    *)
      cmdHelp
      ;;
  esac
}

main "${@}"
