  builtin echo "$([[ "${1:-}" == "desc" ]] && builtin echo "${SUBCMD_USAGE}                 ")Display ${SCRIPT_NAME%%-*} environment information"
  [[ "${1:-}" != "desc" ]] && builtin echo "Options:"
  [[ "${1:-}" != "desc" ]] && builtin echo "  -h, --help  Show this help message"
}

