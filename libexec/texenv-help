helpShell() {
  declare SCRIPT_NAME
  declare SUBCMD_NAME
  declare SUBCMD_USAGE
  SCRIPT_NAME="${0##*/}"
  SUBCMD_NAME="${FUNCNAME[0]##help}"
  SUBCMD_USAGE="${SUBCMD_NAME,,} [options] <version>"
  [[ "${1:-}" != "desc" ]] && builtin echo "builtin echo 'Usage: ${SCRIPT_NAME%%-*} ${SUBCMD_USAGE}'"
  builtin echo "builtin echo '$([[ "${1:-}" == "desc" ]] && builtin echo "${SUBCMD_USAGE}     ")Spawn a new shell with specified TeX Live version'"
  [[ "${1:-}" != "desc" ]] && builtin echo "builtin echo 'If no version is specified, the currently configured shell-specific version is used'"
  [[ "${1:-}" != "desc" ]] && builtin echo "builtin echo 'Options:'"
  [[ "${1:-}" != "desc" ]] && builtin echo "builtin echo '  -h, --help  Show this help message'"
}

