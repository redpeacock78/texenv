#!/usr/bin/env bash

declare -r TEXENV_DEBUG
[[ "${TEXENV_DEBUG}" == 1 ]] && set -x
set -euo pipefail

# Display current TeX Live version
resolveVersion() {
  declare DIR
  declare VERSION
  declare VERSION_PATH
  DIR="${TEXENV_DIR}"
  if [[ -n "${TEXENV_VERSION}" ]]; then
    builtin echo "TinyTeX-Version: ${TEXENV_VERSION}"
    builtin echo "TinyTeX-Path: ${TEXENV_SHELL}"
  else
    [[ -d "${TEXENV_VERSIONS:-}" ]] && {
      if [[ -f "${TEXENV_ROOT}/${TEX_GLOBAL_VERSION_FILE}" ]]; then
        VERSION="$(cat "${TEXENV_ROOT}/${TEX_GLOBAL_VERSION_FILE}")"
        VERSION_PATH="${TEXENV_ROOT}/${TEX_GLOBAL_VERSION_FILE}"
      fi
      while [[ "${DIR}" != "/" ]]; do
        if [[ -f "${DIR}/${TEX_LOCAL_VERSION_FILE}" ]]; then
          VERSION="$(cat "${DIR}/${TEX_LOCAL_VERSION_FILE}")"
          VERSION_PATH="${DIR}/${TEX_LOCAL_VERSION_FILE}"
          break
        fi
        DIR="${DIR%/*}"
        [[ -z "${DIR}" ]] && break
      done
      [[ -n "${VERSION}" ]] && builtin echo "TinyTeX-Version: ${VERSION}"
      [[ -n "${VERSION_PATH}" ]] && builtin echo "TinyTeX-Path: ${VERSION_PATH}"
    }
  fi
}

# Execute command in current TeX Live version
executeRun() {
  declare VERSION
  declare VERSION_PATH
  declare TEX_VERSION_INFO
  declare CMD
  declare CMD_PATH
  declare SCRIPT_NAME
  SCRIPT_NAME="${0##*/}"
  if [[ -d "${TEXENV_VERSIONS}" ]]; then
    TEX_VERSION_INFO="$(resolveVersion)"
    VERSION="$(awk -F": " '/TinyTeX-Version: /{print $2}' <<< "${TEX_VERSION_INFO}")"
    VERSION_PATH="$(awk -F": " '/TinyTeX-Path: /{print $2}' <<< "${TEX_VERSION_INFO}")"
    [[ -z "${VERSION}" || -z "${VERSION_PATH}" ]] && {
      builtin echo "${SCRIPT_NAME%%-*}: no version set (use '${SCRIPT_NAME%%-*} global <version>' or '${SCRIPT_NAME%%-*} local <version>')" >&2
      exit 1
    }
    CMD="${1:-}"
    shift || true
    [[ -z "${CMD}" ]] && {
      builtin echo "${SCRIPT_NAME%%-*}: no command specified" >&2
      exit 1
    }
    CMD_PATH="${TEXENV_VERSIONS}/${VERSION}/bin/${TEXENV_PLATFORM}/${CMD}"
    [[ -x "${CMD_PATH}" ]] || {
      builtin echo "${SCRIPT_NAME%%-*}: command '${CMD}' not found in version '${VERSION}'" >&2
      exit 1
    }
    export TEXMFHOME="${TEXMF_HOME:-}"
    export PATH="${TEXENV_VERSIONS}/${VERSION}/bin/${TEXENV_PLATFORM}:${PATH}"
    ${CMD_PATH} "${@}"
  else
    builtin echo "${SCRIPT_NAME%%-*}: no version set (use '${SCRIPT_NAME%%-*} global <version>' or '${SCRIPT_NAME%%-*} local <version>')" >&2
    exit 1
  fi
}

# Run hooks for specific event and phase
runHooks() {
  declare EVENT
  declare PHASE
  declare -a ARGS
  declare HOOK_DIR
  EVENT="${1:-}"
  PHASE="${2:-}"
  ARGS=("${@:3}")
  HOOK_DIR="${TEXENV_HOOKS}/${EVENT}/${PHASE}"
  [[ -d "${HOOK_DIR}" ]] || return 0
  while read -r HOOK_SCRIPT; do
    [[ -x "${HOOK_SCRIPT}" ]] && "${HOOK_SCRIPT}" "${ARGS[@]:-}"
  done < <(find "${HOOK_DIR}" -maxdepth 1 -type f | sort)
}

main() {
  case "${1:-}" in
    resolveVersion)
      resolveVersion
      ;;
    executeRun)
      shift || true
      executeRun "${@}"
      ;;
    runHooks)
      shift || true
      runHooks "${@}"
      ;;
  esac
}

main "${@}"
