#!/usr/bin/env bash

declare -r TEXENV_DEBUG
[[ "${TEXENV_DEBUG}" == 1 ]] && set -x
set -euo pipefail

isSafePathName() {
  [[ "${1:-}" =~ ^[A-Za-z0-9._-]+$ && "${1:-}" != "." && "${1:-}" != ".." ]]
}

isSafeVersion() {
  [[ "${#}" == 1 ]] && isSafePathName "${1}"
}

isSafeCommand() {
  [[ "${#}" == 1 ]] && isSafePathName "${1}"
}

shellQuote() {
  builtin printf '%q' "${1-}"
}

# Normalize TeX Live package names for portable requirements files.
normalizePackageNames() {
  # ponytail: keep the platform list local to avoid network-dependent tlmgr calls; update it when TeX Live adds a platform.
  awk '
    {
      sub(/\r$/, "", $0)
      sub(/^[[:space:]]+/, "", $0)
      sub(/[[:space:]]+$/, "", $0)
      if ($0 == "" || $0 ~ /^#/) next
      sub(/\.(aarch64-linux|amd64-freebsd|amd64-netbsd|armhf-linux|i386-freebsd|i386-linux|i386-netbsd|universal-darwin|windows|x86_64-cygwin|x86_64-darwinlegacy|x86_64-linux|x86_64-linuxmusl)$/, "", $0)
      if (!seen[$0]++) print
    }
  '
}

# Normalize TeX Live package revision rows to name<TAB>revision.
normalizePackageRevisions() {
  awk -F ',' '
    {
      sub(/\r$/, "", $0)
      if (index($0, "\t")) {
        split($0, fields, "\t")
        name=fields[1]
        revision=fields[2]
      } else {
        name=$1
        revision=$2
      }
      sub(/^[[:space:]]+/, "", name)
      sub(/[[:space:]]+$/, "", name)
      sub(/^[[:space:]]+/, "", revision)
      sub(/[[:space:]]+$/, "", revision)
      if (name ~ /^[A-Za-z0-9][A-Za-z0-9._+-]*$/ && revision ~ /^[0-9]+$/ && name !~ /^00texlive\./) print name "\t" revision
    }
  '
}

sha512Stream() {
  declare HASH_TOOL
  declare OUTPUT
  declare HASH
  HASH_TOOL="$(builtin type -P sha512sum || true)"
  if [[ -n "${HASH_TOOL}" ]]; then
    OUTPUT="$("${HASH_TOOL}")" || return 1
    read -r HASH _ <<< "${OUTPUT}"
  else
    HASH_TOOL="$(builtin type -P shasum || true)"
    if [[ -n "${HASH_TOOL}" ]]; then
      OUTPUT="$("${HASH_TOOL}" -a 512)" || return 1
      read -r HASH _ <<< "${OUTPUT}"
    else
      HASH_TOOL="$(builtin type -P openssl || true)"
      [[ -n "${HASH_TOOL}" ]] || return 1
      OUTPUT="$("${HASH_TOOL}" dgst -sha512)" || return 1
      HASH="${OUTPUT##*= }"
    fi
  fi
  [[ "${HASH}" =~ ^[[:xdigit:]]{128}$ ]] || return 1
  builtin printf '%s\n' "${HASH,,}"
}

sha512File() {
  [[ -f "${1:-}" ]] || return 1
  sha512Stream < "${1}"
}

requireTlmgrPerl() {
  declare CMD_NAME
  declare PERL_PATH
  CMD_NAME="${1:-texenv}"
  PERL_PATH="$(builtin type -P perl || true)"
  [[ -z "${PERL_PATH}" ]] && {
    builtin echo "${CMD_NAME}: perl is required for tlmgr" >&2
    return 1
  }
  "${PERL_PATH}" -mFile::Find /dev/null || {
    builtin echo "${CMD_NAME}: perl with File::Find is required for tlmgr (https://github.com/rstudio/tinytex/issues/419)" >&2
    return 1
  }
}

# Display current TeX Live version
resolveVersion() {
  declare DIR
  declare VERSION
  declare VERSION_PATH
  declare NEXT_DIR
  VERSION=""
  VERSION_PATH=""
  DIR="${TEXENV_DIR}"
  if [[ -n "${TEXENV_VERSION}" ]]; then
    builtin echo "TinyTeX-Version: ${TEXENV_VERSION}"
    builtin echo "TinyTeX-Path: ${TEXENV_SHELL:-TEXENV_VERSION}"
  else
    [[ -d "${TEXENV_VERSIONS:-}" ]] && {
      if [[ -f "${TEXENV_ROOT}/${TEX_GLOBAL_VERSION_FILE}" ]]; then
        VERSION="$(cat "${TEXENV_ROOT}/${TEX_GLOBAL_VERSION_FILE}")"
        VERSION_PATH="${TEXENV_ROOT}/${TEX_GLOBAL_VERSION_FILE}"
      fi
      while [[ "${DIR}" != "/" ]]; do
        if [[ -f "${DIR}/${TEX_LOCAL_VERSION_FILE}" ]]; then
          VERSION="$(cat "${DIR}/${TEX_LOCAL_VERSION_FILE}")"
          VERSION_PATH="${DIR}/${TEX_LOCAL_VERSION_FILE}"
          break
        fi
        NEXT_DIR="${DIR%/*}"
        [[ "${NEXT_DIR}" == "${DIR}" ]] && DIR="/" || DIR="${NEXT_DIR:-/}"
      done
      [[ -n "${VERSION}" ]] && builtin echo "TinyTeX-Version: ${VERSION}"
      [[ -n "${VERSION_PATH}" ]] && builtin echo "TinyTeX-Path: ${VERSION_PATH}"
    }
  fi
}

# Execute command in current TeX Live version
executeRun() {
  declare VERSION
  declare VERSION_PATH
  declare -A TEX_VERSION_INFO
  declare CMD
  declare CMD_PATH
  declare CMD_NAME
  declare SCRIPT_NAME
  SCRIPT_NAME="${0##*/}"
  CMD_NAME="${SCRIPT_NAME%%-*}"
  if [[ -d "${TEXENV_VERSIONS}" ]]; then
    while IFS=': ' read -r KEY VALUE; do
      [[ -n "${KEY}" && -n "${VALUE}" ]] && TEX_VERSION_INFO["${KEY}"]="${VALUE}"
    done < <(resolveVersion || true)
    VERSION="${TEX_VERSION_INFO["TinyTeX-Version"]:-}"
    VERSION_PATH="${TEX_VERSION_INFO["TinyTeX-Path"]:-}"
    [[ -z "${VERSION}" || -z "${VERSION_PATH}" ]] && {
      builtin echo "${CMD_NAME}: no version set (use '${CMD_NAME} global <version>' or '${CMD_NAME} local <version>')" >&2
      exit 1
    }
    isSafeVersion "${VERSION}" || {
      builtin echo "${CMD_NAME}: invalid version identifier" >&2
      exit 1
    }
    CMD="${1:-}"
    shift || true
    [[ -z "${CMD}" ]] && {
      builtin echo "${CMD_NAME}: no command specified" >&2
      exit 1
    }
    isSafeCommand "${CMD}" || {
      builtin echo "${CMD_NAME}: invalid command identifier" >&2
      exit 1
    }
    [[ "${CMD}" == "tlmgr" ]] && requireTlmgrPerl "${CMD_NAME}"
    CMD_PATH="${TEXENV_VERSIONS}/${VERSION}/bin/${TEXENV_PLATFORM}/${CMD}"
    [[ -x "${CMD_PATH}" ]] || {
      builtin echo "${CMD_NAME}: command '${CMD}' not found in version '${VERSION}'" >&2
      exit 1
    }
    export TEXMFHOME="${TEXMF_HOME:-}"
    export PATH="${TEXENV_VERSIONS}/${VERSION}/bin/${TEXENV_PLATFORM}:${PATH}"
    "${CMD_PATH}" "${@}"
  else
    builtin echo "${CMD_NAME}: no version set (use '${CMD_NAME} global <version>' or '${CMD_NAME} local <version>')" >&2
    exit 1
  fi
}

# Run hooks for specific event and phase
runHooks() {
  declare EVENT
  declare PHASE
  declare -a ARGS
  declare HOOK_DIR
  EVENT="${1:-}"
  PHASE="${2:-}"
  ARGS=("${@:3}")
  HOOK_DIR="${TEXENV_HOOKS}/${EVENT}/${PHASE}"
  [[ -d "${HOOK_DIR}" ]] || return 0
  while read -r HOOK_SCRIPT; do
    [[ -x "${HOOK_SCRIPT}" ]] && "${HOOK_SCRIPT}" "${ARGS[@]:-}" >&2
  done < <(find "${HOOK_DIR}" -maxdepth 1 -type f | sort)
}

main() {
  case "${1:-}" in
    resolveVersion)
      resolveVersion
      ;;
    executeRun)
      shift || true
      executeRun "${@}"
      ;;
    runHooks)
      shift || true
      runHooks "${@}"
      ;;
    isSafeVersion)
      shift || true
      isSafeVersion "${@}"
      ;;
    isSafeCommand)
      shift || true
      isSafeCommand "${@}"
      ;;
    shellQuote)
      shift || true
      shellQuote "${@}"
      ;;
    normalizePackageNames)
      shift || true
      normalizePackageNames "${@}"
      ;;
    normalizePackageRevisions)
      shift || true
      normalizePackageRevisions "${@}"
      ;;
    sha512Stream)
      shift || true
      sha512Stream "${@}"
      ;;
    sha512File)
      shift || true
      sha512File "${@}"
      ;;
  esac
}

main "${@}"
