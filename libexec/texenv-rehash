#!/usr/bin/env bash

declare -r TEXENV_DEBUG
[[ "${TEXENV_DEBUG}" == 1 ]] && set -x
set -euo pipefail

# Rebuild shims for installed TeX Live versions
cmdRehash() {
  declare CMD_LIST
  declare CMD_PATH_LIST
  declare SHIMS_LIST
  declare ADD_DIFF_LIST
  declare RM_DIFF_LIST
  declare FORCE_REHASH
  declare SCRIPT_NAME
  declare TMP_SHIMS
  declare SHIM_SCRIPT_PATH
  declare BACKUP_SHIMS
  declare cmdHelp
  SCRIPT_NAME="${0##*/}"
  cmdHelp="$(builtin type -P "texenv-help" || true)"
  [[ -z "${cmdHelp}" ]] && {
    builtin echo "${SCRIPT_NAME%%-*}: required component(s) missing" >&2
    exit 1
  }
  case "${1:-}" in
    -f | --force)
      FORCE_REHASH=1
      ;;
    -h | --help)
      builtin exec "${cmdHelp}" "${SCRIPT_NAME##*-}"
      ;;
  esac
  [[ ! -d "${TEXENV_VERSIONS}" ]] && {
    builtin echo "texenv: no versions installed" >&2
    exit 1
  }
  CMD_PATH_LIST="$(find "${TEXENV_VERSIONS}" -path "*/bin/${TEXENV_PLATFORM}/*" ! -type d -exec bash -c 'for f in "${@}"; do [[ -x "${f}" ]] && builtin echo "${f}"; done' _ {} + | sort)"
  CMD_LIST="$(awk -F/ '!a[$NF]++{print $NF}' <<< "${CMD_PATH_LIST}")"
  SHIMS_LIST="$(find "${TEXENV_SHIMS}" -maxdepth 1 -type l | awk -F/ '!a[$NF]++{print $NF}')"
  ADD_DIFF_LIST="$(grep -Fxv -f <(builtin echo "${SHIMS_LIST}") <(builtin echo "${CMD_LIST}") 2> /dev/null || true)"
  RM_DIFF_LIST="$(grep -Fxv -f <(builtin echo "${CMD_LIST}") <(builtin echo "${SHIMS_LIST}") 2> /dev/null || true)"
  [[ "${FORCE_REHASH:-0}" == 0 && -z "${ADD_DIFF_LIST}" && -z "${RM_DIFF_LIST}" ]] && {
    builtin echo "texenv: already up to date"
    return 0
  }
  cleanup() {
    [[ -n "${BACKUP_SHIMS:-}" && -d "${BACKUP_SHIMS}" ]] && mv "${BACKUP_SHIMS}" "${TEXENV_SHIMS}"
    [[ -n "${TMP_SHIMS:-}" && -d "${TMP_SHIMS}" ]] && rm -rf "${TMP_SHIMS:?}"
    builtin echo "texenv: rehash failed" >&2
    exit 1
  }
  trap cleanup ERR INT TERM
  [[ -d "${TEXENV_SHIMS}" ]] && {
    BACKUP_SHIMS="${TEXENV_SHIMS}.bak.${$}"
    mv "${TEXENV_SHIMS}" "${BACKUP_SHIMS}"
  }
  TMP_SHIMS="$(mktemp -d "${TEXENV_ROOT}/.temp_shims_XXXXXX")"
  SHIM_SCRIPT_PATH="${TEXENV_LIBEXEC}/.texenv-shim"
  while read -r CMD; do
    [[ -n "${CMD}" ]] || continue
    declare SHIM_PATH
    SHIM_PATH="${TMP_SHIMS}/${CMD}"
    ln -s "${SHIM_SCRIPT_PATH}" "${SHIM_PATH}"
  done <<< "${CMD_LIST}"
  builtin printf '%s\n' "${CMD_PATH_LIST}" > "${TEX_CMD_LIST_CACHE}"
  mv "${TMP_SHIMS}" "${TEXENV_SHIMS}"
  [[ -n "${BACKUP_SHIMS:-}" && -d "${BACKUP_SHIMS}" ]] && rm -rf "${BACKUP_SHIMS:?}"
  trap - ERR INT TERM
}

cmdRehash "${@}"
